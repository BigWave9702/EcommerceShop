<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>E-shop Activation Email</title>
    <style type="text/css">
      body {
        margin: 0;
        padding: 0;
        background-color: #f9fafb;
        font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #111827;
      }
      .container {
        max-width: 600px;
        margin: auto;
        background: #fff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.4);
      }

      .header {
        background-color: #2563eb;
        padding: 20px;
        text-align: center;
        color: #fff;
      }
      .header h1 {
        margin: 0;
        font-size: 24px;
      }
      .body {
        padding: 30px;
      }
      .body h2 {
        margin-top: 0;
        font-size: 20px;
        color: #111827;
      }
      .order-summary {
        background-color: #f3f4f6;
        padding: 15px;
        border-radius: 6px;
        margin-top: 20px;
        font-size: 14px;
      }
      .order-summary p {
        margin: 16px 0;
        line-height: 1.4;
      }
      .total {
        font-weight: bold;
        font-size: 16px;
        margin-top: 10px;
      }
      .button {
        display: inline-block;
        background-color: #2563eb;
        color: #fff;
        padding: 12px 20px;
        margin-top: 30px;
        text-decoration: none;
        border-radius: 5px;
        font-weight: bold;
      }
      .footer {
        padding: 20px;
        font-size: 12px;
        text-align: center;
        color: #6b7280;
        background-color: #f9fafb;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <h1>Order confirmed!</h1>
      </div>
      <div class="body">
        <p>Hello <%= name %></p>
        <p>
          Thank you for purchase! We've received your order and will start processing it shortly
        </p>
        <div class="order-summary">
          <% cart.forEach(item => { %>
            <p>
              🛒 <strong><%= item.title %></strong> – <%= item.quantity %> × $<%= item.sale_price.toFixed(2) %>
            </p>
          <% }) %>
          <p class="total">Total: $<%= totalAmount.toFixed(2) %></p>
        </div>

        <a href="<%= trackingUrl %>" class="button">📦 Track Your Order</a>

        <p style="margin-top: 20px">
          If you have any questions, just reply to this email or contact us at
          <a href="mailto:support@eshop.com">support@eshop.com</a>.
        </p>
      </div>
      <div class="footer">
        &copy; <%= new Date().getFullYear() %> E-shop. All rights reserved.
      </div>
    </div>
  </body>
</html>
